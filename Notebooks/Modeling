{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"toc_visible":true},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":19,"metadata":{"id":"9KrnKFLjR9M_","executionInfo":{"status":"ok","timestamp":1778382355587,"user_tz":-180,"elapsed":34,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}}},"outputs":[],"source":["import pandas as pd\n","import numpy as np\n","from sklearn.impute import SimpleImputer\n","from sklearn.model_selection import train_test_split\n","from imblearn.over_sampling import SMOTE\n","from google.colab import drive\n","from sklearn.model_selection import StratifiedKFold\n","from sklearn.metrics import roc_auc_score, f1_score, precision_score, recall_score, precision_recall_curve\n","from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.svm import SVC\n","from sklearn.ensemble import RandomForestClassifier\n","from xgboost import XGBClassifier\n","from sklearn.neural_network import MLPClassifier\n","import matplotlib.pyplot as plt\n","from sklearn.metrics import roc_curve"]},{"cell_type":"code","source":["drive.mount('/content/drive', force_remount=True)\n","\n","processed_path = '/content/drive/MyDrive/Alzheimer-Progression-Prediction/Data/Processed/'\n","df = pd.read_csv(processed_path + 'final_dataset.csv')\n","\n","print(f\"Loaded: {df.shape}\")\n","print(f\"Progressors: {df['PROGRESSOR'].sum()} / {len(df)}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VrmlQbvAU0PE","executionInfo":{"status":"ok","timestamp":1778379701915,"user_tz":-180,"elapsed":26860,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"01c961ff-6268-4b96-cbc9-b77edb76c4d1"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Loaded: (2968, 25)\n","Progressors: 291 / 2968\n"]}]},{"cell_type":"code","source":["# General model features (no MRI, no PET interaction)\n","features_general = [\n","    'AGE_AT_VISIT', 'PTGENDER', 'PTEDUCAT', 'APOE4_COUNT',\n","    'LIMMTOTAL', 'LDELTOTAL', 'AVTOT4', 'AVDEL30MIN', 'AVDELTOT',\n","    'TRAASCOR', 'TRABSCOR', 'CATANIMSC', 'CATVEGESC',\n","    'CENTILOIDS', 'RAVLT_SLOPE', 'TRAIL_RATIO'\n","]\n","\n","# PET-enriched model features (adds APOE4 x CENTILOIDS interaction)\n","features_pet = features_general + ['APOE4_CENTILOIDS']\n","\n","# MRI-enriched model features (adds brain volumes)\n","#features_mri = features_general + ['HIPPOCAMPUS_NORM', 'ENTORHINAL_NORM', 'VENTRICLES_NORM']\n","\n","target = 'PROGRESSOR'\n","\n","print(f\"General model: {len(features_general)} features\")\n","print(f\"PET-enriched model: {len(features_pet)} features\")\n","#print(f\"MRI-enriched model: {len(features_mri)} features\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-Vl9gHbATNuX","executionInfo":{"status":"ok","timestamp":1778379705709,"user_tz":-180,"elapsed":16,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"d64e0e13-f5f3-45c8-9ee0-4e6016e596c9"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["General model: 16 features\n","PET-enriched model: 17 features\n"]}]},{"cell_type":"code","source":["from sklearn.preprocessing import LabelEncoder\n","\n","# Fix PTGENDER first before anything else\n","le = LabelEncoder()\n","df['PTGENDER'] = le.fit_transform(df['PTGENDER'].astype(str))\n","\n","print(\"PTGENDER fixed:\")\n","for i, cls in enumerate(le.classes_):\n","    print(f\"  {cls} → {i}\")\n","print(df['PTGENDER'].value_counts())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"YEsYKubxM_E0","executionInfo":{"status":"ok","timestamp":1778379708410,"user_tz":-180,"elapsed":14,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"91a521ae-1994-416b-9241-ed45e8a4defc"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["PTGENDER fixed:\n","  Female → 0\n","  Male → 1\n","PTGENDER\n","1    1589\n","0    1379\n","Name: count, dtype: int64\n"]}]},{"cell_type":"code","source":["from sklearn.preprocessing import StandardScaler\n","\n","scaler = StandardScaler()\n","df[features_general] = scaler.fit_transform(df[features_general])\n","\n","print(\"✅ Scaling done\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EfHd5bBhNC_U","executionInfo":{"status":"ok","timestamp":1778379710919,"user_tz":-180,"elapsed":36,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"d81d35f5-d384-45d2-9c76-50ac4e70efcf"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Scaling done\n"]}]},{"cell_type":"markdown","source":["#General Model Spliting + Smote + Training all 5 Models"],"metadata":{"id":"8bsYjrBeBJgB"}},{"cell_type":"code","source":["# Full dataset — K-Fold will handle splitting internally\n","X_full = df[features_general]\n","y_full = df[target]\n","\n","# StratifiedKFold ensures each fold has the same 9.8% progressor ratio\n","# Without stratification, some folds might have very few or no progressors\n","kf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","\n","results = {}\n","all_probs  = {}  # store probabilities for ROC curves later\n","all_tests  = {}  # store true labels for ROC curves later\n","all_preds  = {}  # store predictions for confusion matrices later\n","\n","print(f\"Total patients: {len(X_full)}\")\n","print(f\"Total progressors: {y_full.sum()} ({y_full.mean()*100:.1f}%)\")\n","print(f\"5-Fold: each fold trains on ~{int(len(X_full)*0.8)} and tests on ~{int(len(X_full)*0.2)} patients ✅\")\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0p2qmb8SfnkG","executionInfo":{"status":"ok","timestamp":1778379713700,"user_tz":-180,"elapsed":17,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"e88dee21-0e3c-4f48-ece8-0f61bf22a5f2"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Total patients: 2968\n","Total progressors: 291 (9.8%)\n","5-Fold: each fold trains on ~2374 and tests on ~593 patients ✅\n"]}]},{"cell_type":"code","source":["def run_kfold(model, model_name, X, y, kf):\n","    \"\"\"\n","    For each fold:\n","    - Imputes NaN on training fold only (prevents data leakage into test)\n","    - Applies SMOTE on training fold only (test fold stays real and untouched)\n","    - Trains model and evaluates on unseen test fold\n","    Final result = average across all 5 folds\n","    \"\"\"\n","    aucs, f1s, precs, recs = [], [], [], []\n","    fold_probs, fold_tests, fold_preds = [], [], []\n","\n","    for fold, (train_idx, test_idx) in enumerate(kf.split(X, y)):\n","        X_train_fold = X.iloc[train_idx].copy()\n","        X_test_fold  = X.iloc[test_idx].copy()\n","        y_train_fold = y.iloc[train_idx]\n","        y_test_fold  = y.iloc[test_idx]\n","\n","        # Impute NaN — fit on train only to avoid leaking test info into training\n","        imputer = SimpleImputer(strategy='median')\n","        X_train_fold = pd.DataFrame(imputer.fit_transform(X_train_fold), columns=X.columns)\n","        X_test_fold  = pd.DataFrame(imputer.transform(X_test_fold), columns=X.columns)\n","\n","        # SMOTE only on training fold — test fold must stay real for honest evaluation\n","        smote = SMOTE(random_state=42)\n","        X_train_bal, y_train_bal = smote.fit_resample(X_train_fold, y_train_fold)\n","\n","        # Train and predict\n","        model.fit(X_train_bal, y_train_bal)\n","        y_pred = model.predict(X_test_fold)\n","        y_prob = model.predict_proba(X_test_fold)[:, 1]\n","\n","        # Store for later plotting\n","        fold_probs.extend(y_prob)\n","        fold_tests.extend(y_test_fold)\n","        fold_preds.extend(y_pred)\n","\n","        # Metrics for this fold\n","        aucs.append(roc_auc_score(y_test_fold, y_prob))\n","        f1s.append(f1_score(y_test_fold, y_pred))\n","        precs.append(precision_score(y_test_fold, y_pred))\n","        recs.append(recall_score(y_test_fold, y_pred))\n","\n","        print(f\"  Fold {fold+1} — AUC: {aucs[-1]:.3f} | F1: {f1s[-1]:.3f} | Precision: {precs[-1]:.3f} | Recall: {recs[-1]:.3f}\")\n","\n","    print(f\"\\n  ✅ Average AUC: {np.mean(aucs):.3f} ± {np.std(aucs):.3f}\")\n","    print(f\"  ✅ Average F1:  {np.mean(f1s):.3f} ± {np.std(f1s):.3f}\")\n","\n","    # Store for ROC and confusion matrix\n","    all_probs[model_name] = fold_probs\n","    all_tests[model_name] = fold_tests\n","    all_preds[model_name] = fold_preds\n","\n","    return {\n","        'AUC':       round(np.mean(aucs), 3),\n","        'F1':        round(np.mean(f1s), 3),\n","        'Precision': round(np.mean(precs), 3),\n","        'Recall':    round(np.mean(recs), 3)\n","    }\n","\n","print(\"K-Fold function ready ✅\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_jMjcmPm3FWz","executionInfo":{"status":"ok","timestamp":1778379716297,"user_tz":-180,"elapsed":17,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"d4d299b8-cb83-468a-bc3a-9d2c868b1815"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["K-Fold function ready ✅\n"]}]},{"cell_type":"markdown","source":["# Logistic Regression (on General Model)"],"metadata":{"id":"H96L-A1VQdXs"}},{"cell_type":"code","source":["print(\"=== Logistic Regression ===\")\n","lr = LogisticRegression(random_state=42, max_iter=1000)\n","results['Logistic Regression'] = run_kfold(lr, 'Logistic Regression', X_full, y_full, kf)"],"metadata":{"id":"flov3vu_gc-i","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1778379722381,"user_tz":-180,"elapsed":889,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"55d390e0-358c-45ec-ecc0-4fa2df9107e8"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Logistic Regression ===\n","  Fold 1 — AUC: 0.822 | F1: 0.355 | Precision: 0.234 | Recall: 0.741\n","  Fold 2 — AUC: 0.829 | F1: 0.378 | Precision: 0.250 | Recall: 0.776\n","  Fold 3 — AUC: 0.782 | F1: 0.356 | Precision: 0.232 | Recall: 0.763\n","  Fold 4 — AUC: 0.835 | F1: 0.377 | Precision: 0.249 | Recall: 0.776\n","  Fold 5 — AUC: 0.789 | F1: 0.339 | Precision: 0.223 | Recall: 0.707\n","\n","  ✅ Average AUC: 0.811 ± 0.022\n","  ✅ Average F1:  0.361 ± 0.015\n"]}]},{"cell_type":"markdown","source":[" # SVM (on General Model)"],"metadata":{"id":"1auvEfuFRYBD"}},{"cell_type":"code","source":["print(\"=== SVM ===\")\n","svm = SVC(probability=True, random_state=42)\n","results['SVM'] = run_kfold(svm, 'SVM', X_full, y_full, kf)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sfEEBbq3QsDI","executionInfo":{"status":"ok","timestamp":1778379748558,"user_tz":-180,"elapsed":23126,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"b6ac2200-a30e-4a05-878c-91570da8e20f"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["=== SVM ===\n","  Fold 1 — AUC: 0.785 | F1: 0.320 | Precision: 0.236 | Recall: 0.500\n","  Fold 2 — AUC: 0.801 | F1: 0.359 | Precision: 0.250 | Recall: 0.638\n","  Fold 3 — AUC: 0.736 | F1: 0.307 | Precision: 0.217 | Recall: 0.525\n","  Fold 4 — AUC: 0.796 | F1: 0.398 | Precision: 0.289 | Recall: 0.638\n","  Fold 5 — AUC: 0.748 | F1: 0.319 | Precision: 0.221 | Recall: 0.569\n","\n","  ✅ Average AUC: 0.773 ± 0.026\n","  ✅ Average F1:  0.341 ± 0.034\n"]}]},{"cell_type":"markdown","source":["# Random Forest (on General Model)"],"metadata":{"id":"6cCpfGFURjGz"}},{"cell_type":"code","source":["print(\"=== Random Forest ===\")\n","rf = RandomForestClassifier(n_estimators=100, random_state=42)\n","results['Random Forest'] = run_kfold(rf, 'Random Forest', X_full, y_full, kf)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Fj23zjFuRWr0","executionInfo":{"status":"ok","timestamp":1778379763658,"user_tz":-180,"elapsed":10795,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"d5d6aec6-4a29-45ab-f17a-957a0b46d0cb"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Random Forest ===\n","  Fold 1 — AUC: 0.795 | F1: 0.222 | Precision: 0.220 | Recall: 0.224\n","  Fold 2 — AUC: 0.831 | F1: 0.339 | Precision: 0.333 | Recall: 0.345\n","  Fold 3 — AUC: 0.782 | F1: 0.396 | Precision: 0.423 | Recall: 0.373\n","  Fold 4 — AUC: 0.807 | F1: 0.330 | Precision: 0.378 | Recall: 0.293\n","  Fold 5 — AUC: 0.783 | F1: 0.364 | Precision: 0.349 | Recall: 0.379\n","\n","  ✅ Average AUC: 0.800 ± 0.018\n","  ✅ Average F1:  0.330 ± 0.059\n"]}]},{"cell_type":"markdown","source":["# XGBoost (on General Model)"],"metadata":{"id":"RmVsLP1WRu5E"}},{"cell_type":"code","source":["print(\"=== XGBoost ===\")\n","xgb = XGBClassifier(random_state=42, eval_metric='logloss')\n","results['XGBoost'] = run_kfold(xgb, 'XGBoost', X_full, y_full, kf)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"z09sLaKcRpwI","executionInfo":{"status":"ok","timestamp":1778379769496,"user_tz":-180,"elapsed":1942,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"6f1f46ca-02d0-48ff-8d8b-31abe54713f0"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["=== XGBoost ===\n","  Fold 1 — AUC: 0.759 | F1: 0.227 | Precision: 0.282 | Recall: 0.190\n","  Fold 2 — AUC: 0.806 | F1: 0.239 | Precision: 0.324 | Recall: 0.190\n","  Fold 3 — AUC: 0.766 | F1: 0.304 | Precision: 0.424 | Recall: 0.237\n","  Fold 4 — AUC: 0.806 | F1: 0.286 | Precision: 0.350 | Recall: 0.241\n","  Fold 5 — AUC: 0.768 | F1: 0.204 | Precision: 0.250 | Recall: 0.172\n","\n","  ✅ Average AUC: 0.781 ± 0.021\n","  ✅ Average F1:  0.252 ± 0.037\n"]}]},{"cell_type":"markdown","source":["#  Neural Network (on General Model)"],"metadata":{"id":"KaaNyfc1R7M8"}},{"cell_type":"code","source":["print(\"=== Neural Network ===\")\n","mlp = MLPClassifier(hidden_layer_sizes=(64, 32), max_iter=500, random_state=42)\n","results['Neural Network'] = run_kfold(mlp, 'Neural Network', X_full, y_full, kf)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Fu8LXND3R1Xq","executionInfo":{"status":"ok","timestamp":1778379814765,"user_tz":-180,"elapsed":42058,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"f083fd10-d0fd-453a-e7ff-67ead1cf08f0"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Neural Network ===\n","  Fold 1 — AUC: 0.702 | F1: 0.265 | Precision: 0.273 | Recall: 0.259\n","  Fold 2 — AUC: 0.725 | F1: 0.362 | Precision: 0.333 | Recall: 0.397\n","  Fold 3 — AUC: 0.650 | F1: 0.259 | Precision: 0.263 | Recall: 0.254\n","  Fold 4 — AUC: 0.682 | F1: 0.268 | Precision: 0.278 | Recall: 0.259\n","  Fold 5 — AUC: 0.637 | F1: 0.206 | Precision: 0.191 | Recall: 0.224\n","\n","  ✅ Average AUC: 0.679 ± 0.032\n","  ✅ Average F1:  0.272 ± 0.050\n"]}]},{"cell_type":"markdown","source":["# Comparison Table + ROC Curves (on General Model)"],"metadata":{"id":"JjDbx2SrSIP9"}},{"cell_type":"code","source":["# Results table\n","results_df = pd.DataFrame(results).T.sort_values('AUC', ascending=False)\n","print(\"=== Final Model Comparison (5-Fold Cross Validation — General Model) ===\")\n","print(results_df)\n","\n","# ROC curves for all 5 models\n","plt.figure(figsize=(9, 6))\n","for model_name in results:\n","    fpr, tpr, _ = roc_curve(all_tests[model_name], all_probs[model_name])\n","    auc = results[model_name]['AUC']\n","    plt.plot(fpr, tpr, label=f\"{model_name} (AUC = {auc:.3f})\")\n","\n","plt.plot([0, 1], [0, 1], 'k--', label='Random Chance')\n","plt.xlabel('False Positive Rate')\n","plt.ylabel('True Positive Rate')\n","plt.title('ROC Curve — All Models (General Dataset, 5-Fold CV)')\n","plt.l