ell_type":"code","source":["def run_kfold(model, model_name, X, y, kf):\n","    \"\"\"\n","    Updated K-Fold function.\n","    Uses SMOTETomek instead of plain SMOTE:\n","    - SMOTE generates synthetic progressors to balance classes\n","    - Tomek Links then removes borderline ambiguous samples\n","    - Result: cleaner, better separated training data\n","    \"\"\"\n","    aucs, f1s, precs, recs = [], [], [], []\n","    fold_probs, fold_tests, fold_preds = [], [], []\n","\n","    for fold, (train_idx, test_idx) in enumerate(kf.split(X, y)):\n","        X_train_fold = X.iloc[train_idx].copy()\n","        X_test_fold  = X.iloc[test_idx].copy()\n","        y_train_fold = y.iloc[train_idx]\n","        y_test_fold  = y.iloc[test_idx]\n","\n","        # Impute NaN on training fold only — prevents data leakage\n","        imputer = SimpleImputer(strategy='median')\n","        X_train_fold = pd.DataFrame(imputer.fit_transform(X_train_fold), columns=X.columns)\n","        X_test_fold  = pd.DataFrame(imputer.transform(X_test_fold), columns=X.columns)\n","\n","        # SMOTETomek: balances classes AND removes noisy borderline samples\n","        # Better than plain SMOTE for medical data with overlapping classes\n","        smt = SMOTETomek(random_state=42)\n","        X_train_bal, y_train_bal = smt.fit_resample(X_train_fold, y_train_fold)\n","\n","        # Train and predict\n","        model.fit(X_train_bal, y_train_bal)\n","        y_pred = model.predict(X_test_fold)\n","        y_prob = model.predict_proba(X_test_fold)[:, 1]\n","\n","        fold_probs.extend(y_prob)\n","        fold_tests.extend(y_test_fold)\n","        fold_preds.extend(y_pred)\n","\n","        aucs.append(roc_auc_score(y_test_fold, y_prob))\n","        f1s.append(f1_score(y_test_fold, y_pred))\n","        precs.append(precision_score(y_test_fold, y_pred))\n","        recs.append(recall_score(y_test_fold, y_pred))\n","\n","        print(f\"  Fold {fold+1} — AUC: {aucs[-1]:.3f} | F1: {f1s[-1]:.3f} | Precision: {precs[-1]:.3f} | Recall: {recs[-1]:.3f}\")\n","\n","    print(f\"\\n  ✅ Average AUC: {np.mean(aucs):.3f} ± {np.std(aucs):.3f}\")\n","    print(f\"  ✅ Average F1:  {np.mean(f1s):.3f} ± {np.std(f1s):.3f}\")\n","\n","    all_probs[model_name] = fold_probs\n","    all_tests[model_name] = fold_tests\n","    all_preds[model_name] = fold_preds\n","\n","    return {\n","        'AUC':       round(np.mean(aucs), 3),\n","        'F1':        round(np.mean(f1s), 3),\n","        'Precision': round(np.mean(precs), 3),\n","        'Recall':    round(np.mean(recs), 3)\n","    }\n","\n","print(\"Updated K-Fold with SMOTETomek ready ✅\")"],"metadata":{"id":"QrwoW5zdANCc","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1778382593645,"user_tz":-180,"elapsed":8,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"cabd6b2c-5ff7-46b4-c08e-54fe99b08041"},"execution_count":29,"outputs":[{"output_type":"stream","name":"stdout","text":["Updated K-Fold with SMOTETomek ready ✅\n"]}]},{"cell_type":"markdown","source":["# CatBoot (on General Model)"],"metadata":{"id":"YP1V2QVWAhSI"}},{"cell_type":"code","source":["print(\"=== CatBoost ===\")\n","\n","# CatBoost handles class imbalance natively with auto_class_weights\n","# Often outperforms XGBoost on medical tabular data\n","cat = CatBoostClassifier(\n","    iterations=500,\n","    learning_rate=0.05,\n","    depth=6,\n","    auto_class_weights='Balanced',  # handles imbalance natively\n","    random_seed=42,\n","    verbose=0  # suppress training logs\n",")\n","\n","results['CatBoost'] = run_kfold(cat, 'CatBoost', X_full, y_full, kf)"],"metadata":{"id":"w631kUjuAeHp","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1778382641283,"user_tz":-180,"elapsed":44949,"user":{"displayName":"Omar isleem","userId":"18353785283954405157"}},"outputId":"9a4de629-1233-4c02-dea7-6216e632f008"},"execution_count":30,"outputs":[{"output_typ